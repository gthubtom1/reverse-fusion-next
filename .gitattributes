# Hash-bearing JSON, skills and shell launchers must have stable checkout bytes
# even when the host's core.autocrlf setting is enabled.
* text=auto eol=lf
*.jar binary
*.wasm binary
*.png binary
*.jpg binary
*.ico binary
# Unified diff context includes a single leading space on blank context lines.
*.patch whitespace=-blank-at-eol
# This frozen handoff is a byte-hashed historical input, including its newline.
evidence/rf22/builder/frozen/state/*.json binary
# RF-33 native receipts/Evidence and delivery snapshots retain exact observed bytes.
evidence/rf33/owned-desk/** binary
# RF-36 raw native bundles/calls retain exact observed IDs and bytes.
evidence/rf36/raw/** binary
# Actual installer/process transcripts preserve their observed newline bytes.
evidence/next/final-audit/*.log binary
